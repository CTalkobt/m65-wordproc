; style.s45 — the style table (conv.c, issue #5): sty, sty_find, sty_init
; on the MEGA65 (conv.c has them in C for the host); sty_save, sty_load and
; sty_remap, run only with a file, are in stylecold.s45 (the overlay
; cold). The table is ST_LIN (wp.h: HI_LIN + $4C00 = $FF87C00, colour RAM),
; st_n entries of a byte, read with the 45GS02's 32-bit indirect [zp],z.
;
; u8 sty(u8 s): s at $10, its entry in A (the last one looked up kept)
; u8 sty_find(u8 e): e at $10, its index in A (added if new; the table
;   full: 0; the last one found kept)
; void sty_init(void): entries 0-31 those styles, the rest 0

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

.global _sty, _sty_find, _sty_init, _raw_fx, __st_ptr
.extern _st_n

.segment "bss"
__sc:   .res 2          ; sty's last: index, entry
__sf:   .res 2          ; sty_find's last: entry, index

.segment "code"

; $10-$13: ST_LIN. A, Z kept. (stylecold.s45's too)
proc __st_ptr
    pha
    lda #$00
    sta $10
    lda #$7c
    sta $11
    lda #$f8
    sta $12
    lda #$0f
    sta $13
    pla
    rts
endproc

proc _sty
    .zp_uses $10
    .zp_clobbers $10, $11, $12, $13
    .zp_release $10, $11, $12, $13
    .reg_clobbers A, Z
    .flag_clobbers C, N, Z, V
    lda $10
    cmp __sc
    beq @hit
    sta __sc
    taz
    jsr __st_ptr
    lda [$10],z
    sta __sc+1
@hit:
    lda __sc+1
    rts
    .func_flags zp_call
endproc

proc _sty_find
    .zp_uses $10
    .zp_clobbers $10, $11, $12, $13, $14
    .zp_release $10, $11, $12, $13, $14
    .reg_clobbers A, Z
    .flag_clobbers C, N, Z, V
    lda $10
    cmp __sf
    bne @look
    lda __sf+1
    rts
@look:
    sta $14
    jsr __st_ptr
    ldz #0
@next:
    lda _st_n+1             ; (256 entries: no end before Z wraps)
    bne @cmp
    cpz _st_n
    beq @add
@cmp:
    lda [$10],z
    cmp $14
    beq @found
    inz
    bne @next
    lda #0                  ; (full)
    rts
@add:
    lda $14
    sta [$10],z
    inc _st_n
    bne @kept
    inc _st_n+1
@kept:
    stz __sc                ; (sty's last: this index, as it is now)
    sta __sc+1
@found:
    lda $14
    sta __sf
    stz __sf+1
    tza
    rts
    .func_flags zp_call
endproc

proc _sty_init
    .zp_clobbers $10, $11, $12, $13
    .zp_release $10, $11, $12, $13
    .reg_clobbers A, Z
    .flag_clobbers C, N, Z, V
    jsr __st_ptr
    ldz #0
    lda #0
@zero:
    sta [$10],z
    inz
    bne @zero
    ldz #31
@ident:
    tza
    sta [$10],z
    dez
    bpl @ident
    lda #32
    sta _st_n
    lda #0
    sta _st_n+1
    sta __sc
    sta __sc+1
    sta __sf
    sta __sf+1
    rts
endproc

; void raw_fx(u8 *d, u8 fx): d at $10/$11 (a raw-view cell's top row in
; the band, rows COLS = 80 apart), fx (a style's bits) at $12: the cell
; drawn with that effect: bold (each row ORed with itself a pixel right),
; italic (the top 7 rows a pixel right), underline (row 14), strikethrough
; (row 8), superscript / subscript (3 rows up / down)
.segment "bss"
__g:    .res 16         ; the cell's rows
__sh:   .res 1          ; the rows' shift
.segment "code"
proc _raw_fx
    .zp_uses $10, $11, $12
    .zp_clobbers $10, $11, $12, $14, $15, $16
    .zp_release $10, $11, $12, $14, $15, $16
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z, V
    lda $10
    sta $14
    lda $11
    sta $15
    ldx #0
@copy:
    ldy #0
    lda ($10),y
    sta __g,x
    jsr @down
    inx
    cpx #16
    bne @copy
    lda $14
    sta $10
    lda $15
    sta $11
    ldy #0                  ; the shift: superscript 3 (rows up), subscript -3
    lda $12
    and #$40
    beq @nosup
    ldy #3
@nosup:
    lda $12
    and #$80
    beq @nosub
    ldy #$fd
@nosub:
    sty __sh
    ldx #0
@row:
    txa
    clc
    adc __sh
    cmp #16
    bcs @blank
    tay
    lda __g,y
    bra @have
@blank:
    lda #0
@have:
    sta $16
    lda $12
    and #$04                ; (A_BOLD)
    beq @1
    lda $16
    lsr
    ora $16
    sta $16
@1:
    lda $12
    and #$08                ; (A_ITAL)
    beq @2
    cpx #7
    bcs @2
    lsr $16
@2:
    lda $12
    and #$10                ; (A_UNDER)
    beq @3
    cpx #14
    bne @3
    lda #$ff
    sta $16
@3:
    lda $12
    and #$20                ; (A_STRIKE)
    beq @4
    cpx #8
    bne @4
    lda #$ff
    sta $16
@4:
    lda $16
    ldy #0
    sta ($10),y
    jsr @down
    inx
    cpx #16
    bne @row
    rts
@down:                      ; $10/$11: a row down
    clc
    lda $10
    adc #80
    sta $10
    bcc @same
    inc $11
@same:
    rts
    .func_flags zp_call
endproc
